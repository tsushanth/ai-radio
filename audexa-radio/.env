# Audexa Radio — Environment
# Generated from .env.example with safe defaults

CLAUDE_MODEL=sonnet

# Reddit — left empty, Reddit sources will skip gracefully
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Retell — optional, phone call-in feature
RETELL_API_KEY=
RETELL_AGENT_ID=

# Radio identity
RADIO_REGION=us
RADIO_LANGUAGE=en
