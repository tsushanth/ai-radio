<icecast>
    <location>Internet</location>
    <admin>admin@audexa.fm</admin>

    <limits>
        <clients>500</clients>
        <sources>24</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <source-password>5J688etweykEMVfTkGXBdw</source-password>
        <relay-password>u65i5he3L7PcIspnoS4ouA</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>u65i5he3L7PcIspnoS4ouA</admin-password>
    </authentication>

    <hostname>radio.audexa.fm</hostname>

    <listen-socket>
        <port>8000</port>
    </listen-socket>

    <!-- English (original, backward compatible) -->
    <mount type="normal">
        <mount-name>/stream</mount-name>
        <fallback-mount>/fallback</fallback-mount>
        <fallback-override>1</fallback-override>
        <charset>UTF-8</charset>
        <public>1</public>
        <stream-name>Audexa Radio</stream-name>
        <stream-description>AI-powered 24/7 news and talk radio</stream-description>
        <stream-url>https://radio.audexa.fm</stream-url>
        <genre>News/Talk</genre>
    </mount>

    <!-- English (explicit /stream-en) -->
