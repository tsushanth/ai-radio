  end

  desc "Push current AAB to Open Testing (beta) track. Pre-req: Play Console > Testing > Open testing must be enabled for this app."
  lane :promote_to_open_testing do
    upload_to_play_store(
      track: "beta",
      aab: "/Users/sushanthtiruvaipati/Documents/GitHub/Audexa/Audexa/app/build/outputs/bundle/release/app-release.aab",
      json_key: "/Users/sushanthtiruvaipati/Documents/apple_dev/cloud_credentials/summaryai-483115-a27fc5121150.json",
      package_name: "com.kreativekoala.audexa",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      release_status: "completed"
    )
  end
