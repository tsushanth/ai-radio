# Claude CLI (authenticate on VM with: claude login)
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet

# Reddit OAuth (from ai-radio-backend)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Retell AI
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=your_radio_agent_id
RETELL_PHONE_NUMBER=+1234567890

# Icecast
ICECAST_SOURCE_PASSWORD=changeme_source
ICECAST_ADMIN_PASSWORD=changeme_admin

# TTS
TTS_HOST1_VOICE=am_adam
TTS_HOST2_VOICE=af_nicole
TTS_MODEL=kokoro
