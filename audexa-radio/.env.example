# ============================================================
# Audexa Radio — Environment Variables
# Copy to .env and fill in real values before deploying
# ============================================================

# --- Claude CLI ---
# Path auto-detected. Override if needed.
# CLAUDE_BIN=/usr/local/bin/claude
CLAUDE_MODEL=sonnet

# --- Reddit (required for news fetching) ---
# Create an app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# --- Retell AI (optional — for phone call-in feature) ---
# Get from https://www.retellai.com
RETELL_API_KEY=
RETELL_AGENT_ID=

# --- Radio Identity ---
# Supported regions: us, uk, in, au, ca, de, fr, es, br, jp, kr, sg, ae, za
RADIO_REGION=us
# BCP 47 language code — drives script language
RADIO_LANGUAGE=en

# --- TTS Tuning (optional overrides) ---
# TTS_SPEED=1.05
# TTS_MODEL=kokoro
# TTS_HOST1_VOICES=am_adam,am_echo,am_eric,am_liam,am_michael,am_onyx,am_orion
# TTS_HOST2_VOICES=af_alloy,af_bella,af_jessica,af_nicole,af_nova,af_sarah,af_sky,af_river

# --- Buffer Tuning (optional) ---
# MIN_BUFFER_SEGMENTS=20
# MAX_BUFFER_SEGMENTS=40

# --- Icecast passwords (must match icecast/icecast.xml) ---
# ICECAST_SOURCE_PASSWORD=  # set in icecast.xml
# ICECAST_ADMIN_PASSWORD=   # set in icecast.xml
